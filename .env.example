# Токен Telegram-бота, выданный @BotFather
BOT_TOKEN=123456:AAABBBCCC...

# Публичный HTTPS-адрес, на котором задеплоено Mini App (папка public/).
# Должен совпадать с URL, который вы укажете в @BotFather -> Bot Settings -> Menu Button / Web App.
WEBAPP_URL=https://xn--80aaxq2ah.xn--p1ai

# Каноничный публичный домен сервиса (кириллический), используется для проверки
# Origin/Referer в CSRF-защите и в CORS. Punycode-эквивалент автодай.рф.
PUBLIC_ORIGIN=https://xn--80aaxq2ah.xn--p1ai

# Токен бота MAX (dev.max.ru) — опционально, бот MAX отключён, пока не задан
MAX_BOT_TOKEN=

# Прямая ссылка на чат с ботом в MAX (business.max.ru выдаёт её после
# регистрации бота) — опционально, используется для кнопки «Открыть чат в MAX»
# на экране входа. Пример: https://max.ru/your_bot_username
MAX_BOT_LINK=

# Порт HTTP-сервера (Express отдаёт и Mini App, и API)
PORT=3000

# telegram_id администраторов через запятую — им доступны служебные команды бота
ADMIN_IDS=

# Путь к файлу базы данных SQLite
DB_PATH=./data/avtodai.db

# Обязательно, если задан MAX_BOT_TOKEN и основной сервер работает НЕ в
# российском дата-центре (например, bothost в Нидерландах): API MAX
# (business.max.ru) отдаёт сертификат, подписанный Russian Trusted Root CA
# (Минцифры) — этого корня нет в стандартном доверенном хранилище Node.js,
# без него запросы к MAX будут падать по TLS. Сертификат уже лежит в репозитории —
# укажите путь до него как есть:
NODE_EXTRA_CA_CERTS=./certs/russian_trusted_ca.pem
